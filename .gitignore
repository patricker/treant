/target/
**/*.rs.bk
Cargo.lock

# Docs site
docs/build/
docs/node_modules/
docs/.docusaurus/

# WASM
treant-wasm/pkg/
treant-wasm/target/

# Playwright / screenshots
.playwright-mcp/
*.png
# ...but site images are real assets
!docs/static/img/*.png

# Visual-companion brainstorm mockups (local, not committed)
.superpowers/

# Calibration harness raw output is untracked scratch; the curated record is
# plans/ai-calibration-results.md and the shipped blocks live in each game tile.
plans/ai-calibration-results.txt

# Capacitor app (app/). node_modules and the built web root are artifacts;
# the android/ and ios/ project skeletons ARE committed (Capacitor convention),
# with their own .gitignores excluding build outputs (.gradle, build/, Pods, …).
app/node_modules/
app/www/
# The global *.png rule above would swallow the app icons/splashes and the
# generated launcher assets — re-include the ones we intend to commit.
!app/resources/*.png
!app/android/**/*.png
!app/ios/**/*.png
!app/store-assets/*.png
